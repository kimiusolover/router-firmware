{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://router-firmware.invalid/schemas/tiny-features-v1.schema.json",
  "title": "router-firmware tiny feature policy v1",
  "type": "object",
  "required": ["schema", "package", "required", "conditional", "excluded", "upstream-required"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "router-firmware.tiny-features/v1"},
    "package": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]*$"},
    "required": {"$ref": "#/$defs/features"},
    "excluded": {"$ref": "#/$defs/features"},
    "upstream-required": {"$ref": "#/$defs/features"},
    "conditional": {"type": "array", "items": {"type": "object", "required": ["feature", "requires"], "additionalProperties": false, "properties": {"feature": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]*$"}, "requires": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(device|certification|deployment)\\.[a-z0-9][a-z0-9._-]*$"}}}}},
    "binaries": {"$ref": "#/$defs/allowlist"},
    "units": {"$ref": "#/$defs/allowlist"}
  },
  "$defs": {
    "features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]*$"}},
    "allowlist": {"type": "object", "required": ["required"], "additionalProperties": false, "properties": {"required": {"$ref": "#/$defs/features"}}}
  }
}
